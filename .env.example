# Copy this file to .env.local for `vercel dev`. Leave the values blank here.
# Choose the passcodes yourself. Do not commit real ones.

# Passcode Eabha types to log a workout.
EABHA_PIN=

# Passcode Niall types to open the coach view. Use a different passcode.
NIALL_PIN=

# Long random string that signs the sign-in token. Nobody types this.
LOG_SECRET=

# Filled in when Upstash Redis is connected from the Vercel Marketplace.
# The integration may set either pair. Redis.fromEnv() and logging both accept both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
